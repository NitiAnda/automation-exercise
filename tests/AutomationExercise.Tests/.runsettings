<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <Playwright>
    <BrowserName>chromium</BrowserName>
    <LaunchOptions>
      <Headless>true</Headless>
    </LaunchOptions>
  </Playwright>
  <NUnit>
    <!-- Limit to 3 concurrent browser contexts; the demo site throttles under heavier load -->
    <NumberOfTestWorkers>3</NumberOfTestWorkers>
  </NUnit>
</RunSettings>
